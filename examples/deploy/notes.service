# Install only after placing your native binaries/libraries and reviewing limits.
# systemd on Linux; memory and CPU accounting cover the whole service cgroup.
[Unit]
Description=Stiff persistent notes example
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/stiff/stiff-run --grace-ms 6000 -- /opt/stiff/notes --threads 4 /var/lib/stiff-notes/notes.db 8080
Restart=no
KillMode=control-group
TimeoutStopSec=8
MemoryMax=512M
MemorySwapMax=0
CPUQuota=200%
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
StateDirectory=stiff-notes
StateDirectoryMode=0700
WorkingDirectory=/var/lib/stiff-notes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
